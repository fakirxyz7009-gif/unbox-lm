# Copy this file to .env and keep .env out of git. Every setting is optional unless noted.
# The Electron app reads .env from the project folder, then from the folder next to the exe, then from its user-data folder.

# Gemini powers the AI Combinator, the preset crafter and the mix notes. The key is read on the server only and is
# never sent to the browser. Without a key the local planner and rules run instead. The placeholder counts as unset.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Text model for the AI routes (default gemini-2.5-flash).
# GEMINI_TEXT_MODEL="gemini-2.5-flash"
# AI requests allowed per IP address per minute (default 20).
# AI_RATE_LIMIT_PER_MIN=20

# Port for the web server (default 3000).
# PORT=3000

# Local assistant: the Ollama address, when Ollama runs on this computer (default http://127.0.0.1:11434).
# OLLAMA_URL="http://127.0.0.1:11434"

# Plugin and content library to index, separated by ";" (default D:\vsr). It is read only: nothing in it is run or changed.
# VST_LIBRARY_ROOTS="D:\vsr"
# Where the library index is written (default data/vsr-manifest.json).
# VST_MANIFEST_PATH="data/vsr-manifest.json"
# Let other computers on the network read the library API. Off by default, because the API lists local paths.
# VST_LIBRARY_ALLOW_REMOTE=1

# Folder of recorded samples for the instrument converter (default D:\samples, then public/samples).
# SAMPLE_LIBRARY_PATH="D:\samples"

# Development only: turns off hot module reload.
# DISABLE_HMR=true
