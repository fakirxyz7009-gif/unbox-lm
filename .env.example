# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini model for the AI Combinator and other text routes (default gemini-2.5-flash).
# GEMINI_TEXT_MODEL="gemini-2.5-flash"

# Plugin / content library to index (";"-separated). Default: D:\vsr
# VST_LIBRARY_ROOTS="D:\vsr"
# Where the library index is written. Default: data/vsr-manifest.json
# VST_MANIFEST_PATH="data/vsr-manifest.json"
# Let other computers on the network read the library API (off by default: it lists local paths).
# VST_LIBRARY_ALLOW_REMOTE="1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
