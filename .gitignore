data/instrument-cache/
.tmp/

# Desktop build outputs (electron-builder and the share-build checks); regenerated by npm run dist:win
/release/
/release-build/
/release-dist/
/release-pack-v2/

# Canonical release baseline: generated bundles and unreferenced demo masters
/release-build-v5/
/public/songs/off_topic/
