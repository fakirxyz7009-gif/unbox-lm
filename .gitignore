node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
# Generated: machine-specific library index (absolute local paths) and the bundled desktop API
data/vsr-manifest*.json
electron/api-server.cjs
# In-app library bundle: copied preview audio from the local library (machine-specific content)
public/library/
# Multi-sampled real recordings (large audio files downloaded or generated locally)
public/samples/
# Instrument tool downloads (originals; deleted after a build unless --keep-cache)
data/instrument-cache/
.tmp/

# Desktop build outputs (electron-builder and the share-build checks); regenerated by npm run dist:win
/release/
/release-build/
/release-dist/
/release-pack-v2/

# Third-party checkouts and every CMake build tree under them: all generated. The VST3 SDK is fetched
# at a pinned tag and scripts/vst3/smoke.ps1 rebuilds the fixtures, so none of it belongs in git.
/third_party/

# Canonical release baseline: generated bundles and unreferenced demo masters
/release-build-v5/
/public/songs/off_topic/
/public/songs/love_ya/
/shots/review-instruments-1600.png
/.vs/
