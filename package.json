  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@google/genai": "^2.30.0",
    "@spotify/basic-pitch": "1.0.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.1"
  },
  "main": "electron/main.cjs",
  "description": "Unbox Studio - browser and desktop music workstation",
  "author": "Unbox Studios",
  "build": {
    "appId": "studio.unbox.app",
    "productName": "Unbox Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Unbox-Studio.exe",
      "icon": "build/icon.png"
    }
  },
  "overrides": {
    "esbuild": "^0.28.0"
  },
  "allowScripts": {
    "@google/genai@2.30.0": true,
    "electron@45.0.0": true,
    "esbuild@0.28.2": true,
    "protobufjs": true
  }
}
